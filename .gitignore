# ── macOS
.DS_Store
._*

# ── 构建产物（build.sh 会重新生成）
.build/
cal-app/build/
# 图标整套都是 Icon.swift 画出来的，不存进仓库
cal-app/icon/
*.app

# 开发过程中的截图（含真实课表与姓名），公开仓库只发布 docs/screenshots 里裁剪过的
cal-app/screenshots/

# ── 本地备份与工作区
backups/
.workbuddy/
dsh-market-gen/

# ── 运行日志（模型/调试输出）
*.log

# ── 真实配置绝不入库：本地配置在 ~/.config/dsh-cal/，仓库里只放 config.example.json
config.json
pending.json
calendars.json

# ── 编辑器
.vscode/
.idea/
*.swp

# ── 发行打包产物
dist/
