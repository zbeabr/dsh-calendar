{
  "name": "dsh-cal",
  "version": "1.3.0",
  "description": "用中文自然语言建日历：规则解析 + CalDAV(iCloud) + MCP，零依赖",
  "type": "module",
  "license": "MIT",
  "bin": {
    "dsh-cal": "./cli.mjs"
  },
  "scripts": {
    "test": "node parse-cases.mjs && node safety-cases.mjs && node caldav-cases.mjs && node llm-guard-cases.mjs && node parse-corpus.mjs",
    "test:llm": "node llm-cases.mjs",
    "test:llm-guard": "node llm-guard-cases.mjs",
    "login": "node cli.mjs login",
    "doctor": "node cli.mjs doctor",
    "mcp": "node mcp-server.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "calendar",
    "caldav",
    "icloud",
    "natural-language",
    "chinese",
    "nlp",
    "mcp"
  ],
  "files": [
    "cli.mjs",
    "mcp-server.mjs",
    "src/"
  ]
}
